%% McKenzie OS - Component Dependency Graph
%% Generated 2026-05-08 from a static scan of `import ... from "@/..."` edges
%% across src/app, src/components, src/hooks, src/lib, src/data, src/config.
%% Render with any Mermaid renderer (e.g. https://mermaid.live).
%%
%% Layers (top to bottom):
%%   pages   = src/app/*/page.tsx + layout.tsx + api/* (entry points)
%%   chrome  = src/components/desktop/*
%%   apps    = src/components/apps/*  (incl. apps/whoop, settings, players)
%%   ui      = src/components/ui/*
%%   hooks   = src/hooks/*
%%   lib     = src/lib/*
%%   data    = src/data/*
%%   config  = src/config/*
%%
%% Notes:
%%   - WindowContent has 33 outbound edges (highest in the repo).
%%   - data/fs and useDesktopStore each receive 16 inbound edges.
%%   - One mild cycle: DesktopShell -> Desktop -> MenuBar -> DesktopShell
%%     (broken in tech-debt P1-10).

