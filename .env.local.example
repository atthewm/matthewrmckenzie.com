# =============================================================================
# McKenzie OS Environment Variables
# =============================================================================
# Copy this to .env.local and fill in real values.
# NEVER commit .env.local to git.
# =============================================================================

# -- Gate (admin sign-in at /gate) --
# The site itself is public. Signing in at /gate as the admin unlocks guestbook
# moderation, the private Notion fields and the owner-only apps.
# Sign-in is refused until the admin password and the cookie secret are set:
# there are no built-in defaults. Five wrong passwords from one address make
# the next try wait, longer after each miss (kept in memory, per instance).
#
# Optional. When it is unset there is no username: the password alone signs
# in, whatever is typed in the username box. There is no default "admin".
SITE_LOCK_ADMIN_USER=
# 16 characters or more. A shorter password turns admin sign-in off.
SITE_LOCK_ADMIN_PASSWORD=
# Signs role-bound, per-login gate credentials. Every active login also needs
# a live site:gate:session: record in the existing KV store configured below.
# Use at least 16 random characters. Rotating this key retires all roles.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SITE_LOCK_COOKIE_VALUE=
# Optional guest account. It gets its own cookie, never the admin one.
# SITE_LOCK_GUEST_USER follows the same rule as SITE_LOCK_ADMIN_USER.
# SITE_LOCK_GUEST_USER=
# SITE_LOCK_GUEST_PASSWORD=

# -- Owner cookie (Life and Nutrition apps, full WHOOP feed, WHOOP connect and disconnect) --
# Required: its own random value, 32 characters or more. There is no fallback
# to another key; unset or shorter means nobody is owner.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OWNER_COOKIE_SECRET=

# -- Owner mobile number, written only into the vCard at /card/vcard --
# Full international form, for example +15125550123. Never commit the real
# value. Leave unset and the vCard has no mobile line.
OWNER_MOBILE_E164=

# =============================================================================
# Supabase (Guestbook + Contact form)
# =============================================================================
# The anon key may only add guestbook entries and read approved ones; the
# admin view and moderation use SUPABASE_SERVICE_ROLE_KEY (below) on the server.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# =============================================================================
# WHOOP Developer API Integration
# =============================================================================

# -- WHOOP OAuth credentials (from developer.whoop.com) --
WHOOP_CLIENT_ID=your-client-id-here
WHOOP_CLIENT_SECRET=your-client-secret-here
WHOOP_REDIRECT_URI=https://matthewrmckenzie.com/api/whoop/auth/callback

# -- Encryption key for token storage (64 hex chars = 32 bytes) --
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHOOP_ENCRYPTION_KEY=generate-a-64-hex-char-key-here

# -- Vercel KV / Upstash Redis --
# These are auto-populated when you link a KV store in the Vercel dashboard.
KV_REST_API_URL=https://your-kv-instance.upstash.io
KV_REST_API_TOKEN=your-kv-rest-api-token

# -- Public base URL (used for OAuth redirect) --
NEXT_PUBLIC_BASE_URL=https://matthewrmckenzie.com

# =============================================================================
# Notion <> Site Sync  (Nutrition, Media Library, etc.)
# =============================================================================
# Internal integration token from https://www.notion.so/my-integrations
# Share each source database with the integration in Notion (•••  -> Connections).
NOTION_TOKEN=secret_xxx

# Required for the sync. Vercel sends it as "Authorization: Bearer <value>" on
# every cron run once it is set on the project, and /api/notion/sync accepts
# nothing else (no query string secret, no x-vercel-cron header on its own).
# Manual runs send the same header. 16 characters or more.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# Supabase SERVICE ROLE key (server only): reads and writes the notion_cache
# table, and moderates the guestbook after the admin check. Find it in
# Supabase -> Project Settings -> API. NEVER expose to client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -- Optional database id overrides (defaults baked into src/lib/notion/config.ts) --
# NOTION_DB_NUTRITION=089c0ce983db4f6abe5205d8782f8278
# NOTION_DB_MEAL_ENTRIES=f22e960b143c48028f4b1457bbb2ca06
# NOTION_DB_FILMS=22a708535bf849109b0dc1a04a6e01a5
# NOTION_DB_TV=0d6bf30c62e74a70a8c348642555936d
# NOTION_DB_BOOKS=d9d41421a52240e68edb422f68003858
# NOTION_DB_PEOPLE=84adf0f9e8c047f1aabc44f0421d54e4
# NOTION_DB_RECIPES=8cf57959e19d4168885d92ae1c1a8e1a

# =============================================================================
# Desktop background media (optional)
# =============================================================================
# Public https URL of the backgrounds folder in Cloudflare R2. While this is
# unset the site serves the copies in public/backgrounds. Set it here AND in
# the Vercel project once scripts/backgrounds-to-r2.mjs has uploaded and
# verified the files.
# NEXT_PUBLIC_BACKGROUNDS_BASE_URL=

# Read only by scripts/backgrounds-to-r2.mjs on your machine. Not needed on
# Vercel. Use an R2 API token limited to Object Read and Write on one bucket.
# R2_S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_BACKGROUNDS_PREFIX=backgrounds
